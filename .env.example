# ==========================================
# UnityDrop Backend Environment Configuration
# ==========================================

# Server Environment
NODE_ENV=development
PORT=8000
PLATFORM=render
LOG_LEVEL=debug
VERCEL=0
RENDER=false

# Database Configuration (MongoDB Atlas or Local MongoDB)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/unitydrop?retryWrites=true&w=majority

# Client Application URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Authentication & Security Secrets
JWT_ACCESS_TOKEN_SECRET_KEY=your_jwt_access_token_secret_here
JWT_REFRESH_TOKEN_SECRET_KEY=your_jwt_refresh_token_secret_here
PASSWORD_RESET_TOKEN_PRIVATE_KEY=your_password_reset_private_key_here
JWT_SECRET=your_fallback_jwt_secret_here

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# Google reCAPTCHA v2 (Server-side validation)
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Cache & Expiry Durations (e.g., 5m, 1h, 7d)
CACHE_TTL_MINUTES=5
DONATION_REQUEST_EXPIRY_DAYS=7
FEEDBACK_EXPIRY_DAYS=7
OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_EXPIRY_MINUTES=10

# Application Limits
ADMIN_QUOTA_LIMIT=2
