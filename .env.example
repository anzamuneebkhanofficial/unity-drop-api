# ==========================================
# UNITY-DROP BACKEND ENVIRONMENT CONFIG (.example)
# ==========================================

# 1. Primary Environment Setup
NODE_ENV=development
PORT=8000
PLATFORM=render
LOG_LEVEL=debug

VERCEL=0
RENDER=false

# 2. Connection Strings
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/unitydrop

# 3. Security & Authentication
# The Frontend URL that is allowed to access this API
FRONTEND_URL=http://localhost:3000

JWT_ACCESS_TOKEN_SECRET_KEY=your_access_secret_here
JWT_REFRESH_TOKEN_SECRET_KEY=your_refresh_secret_here
PASSWORD_RESET_TOKEN_PRIVATE_KEY=your_private_key
JWT_SECRET=your_secret_key

# 4. Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=noreply@unitydrop.com

# 5. Third-Party Integrations
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# 6. AI (Gemini / Groq)
GEMINI_AI_PROVIDER=GEMINI
Groq_AI_PROVIDER=Groq
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
AI_SUGGESTION_LIMIT=5

# 7. Database Tuning
BAD_REQUEST_THRESHOLD=1
CACHE_TTL_MINUTES=1

# 8. Expiration Settings (in Days)
BAD_REQUEST_EXPIRY_DAYS=7
WARNING_EXPIRY_DAYS=7
DONATION_REQUEST_EXPIRY_DAYS=7
FEEDBACK_EXPIRY_DAYS=7

# 9. Expiration Settings (in Minutes)
OTP_EXPIRY_MINUTES=2
PASSWORD_RESET_EXPIRY_MINUTES=2

# 10. Grace Period Settings (in Seconds)
TERMINATION_GRACE_PERIOD_SECONDS=60

# 11. Admin Settings
ADMIN_QUOTA_LIMIT=2
ADMIN_APPROVAL_WINDOW_HOURS=24
